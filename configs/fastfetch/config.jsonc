{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/hous/.config/omarchy/assets/hs_logo.png",
    "type": "chafa",
    "width": 30,
    "height": 15,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " 󰄾 ",
    "color": {
      "separator": "cyan"
    },
    "percent": {
      "type": 3
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": " "
      },
      "width": 12
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}󰧔{host-name-colored}  // \u001b[36mTELEMETRY ONLINE\u001b[0m"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": " KRNL",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": " COMP",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": " TERM",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": " SHELL",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "󱫐 UPTIME",
      "keyColor": "cyan"
    },
    {
      "type": "separator",
      "string": "┄"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "green",
      "showPeCoreCount": true,
      "temp": true
    },
    {
      "type": "gpu",
      "key": "󰍛 GPU",
      "keyColor": "green",
      "temp": true
    },
    {
      "type": "memory",
      "key": " RAM",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": " NVME",
      "keyColor": "green"
    },
    {
      "type": "battery",
      "key": "󰁹 PWR",
      "keyColor": "green"
    },
    {
      "type": "localip",
      "key": "󰩟 NET",
      "keyColor": "green",
      "showIpv4": true,
      "showIpv6": false,
      "showLoopback": false
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
