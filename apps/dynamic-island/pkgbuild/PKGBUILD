pkgname=dynamic-island
pkgver=0.1.0
pkgrel=1
pkgdesc='Inspect, revive, and restart the Omarchy Dynamic Island shell plugin'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/dynamic-island "$pkgdir/usr/bin/dynamic-island"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/dynamic-island.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/dynamic-island.svg"
  install -Dm644 "$startdir/dynamic-island.desktop" "$pkgdir/usr/share/applications/dynamic-island.desktop"
}
