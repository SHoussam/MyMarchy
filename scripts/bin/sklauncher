#!/usr/bin/env bash
set -e

# Resolve java binary
if command -v java >/dev/null 2>&1; then
    JAVA_CMD="java"
elif [ -x "$HOME/.local/share/mise/shims/java" ]; then
    JAVA_CMD="$HOME/.local/share/mise/shims/java"
elif [ -x "$HOME/.local/share/mise/installs/java/21/bin/java" ]; then
    JAVA_CMD="$HOME/.local/share/mise/installs/java/21/bin/java"
else
    echo "Error: Java is not found. Please install Java (17 or 21+)." >&2
    exit 1
fi

JAR_PATH="$HOME/.local/share/sklauncher/SKlauncher.jar"

if [ ! -f "$JAR_PATH" ]; then
    echo "Error: SKlauncher jar not found at $JAR_PATH" >&2
    exit 1
fi

exec "$JAVA_CMD" -jar "$JAR_PATH" "$@"
