#!/usr/bin/env bash
# Terminate active window and completely kill its underlying process

set -euo pipefail

win=$(hyprctl activewindow -j 2>/dev/null || true)
if [ -z "$win" ] || [ "$win" = "{}" ]; then
    exit 0
fi

class=$(echo "$win" | jq -r '.class // empty')
pid=$(echo "$win" | jq -r '.pid // empty')
addr=$(echo "$win" | jq -r '.address // empty')

# Protect desktop shell / bar from being killed
if [ "$class" = "omarchy-shell" ] || [ "$class" = "waybar" ]; then
    exit 0
fi

hypr_pid=$(pgrep -x Hyprland 2>/dev/null | head -n 1 || true)

if [ -n "$pid" ] && [ "$pid" -gt 1 ] && [ "$pid" != "$hypr_pid" ]; then
    # Try SIGTERM first on child processes and parent
    pkill -TERM -P "$pid" 2>/dev/null || true
    kill -TERM "$pid" 2>/dev/null || true

    # Wait brief moment, then SIGKILL if still running
    sleep 0.1
    if kill -0 "$pid" 2>/dev/null; then
        pkill -KILL -P "$pid" 2>/dev/null || true
        kill -KILL "$pid" 2>/dev/null || true
    fi
fi

# Also ensure window is removed from Hyprland
if [ -n "$addr" ]; then
    hyprctl dispatch closewindow "address:$addr" >/dev/null 2>&1 || true
fi
